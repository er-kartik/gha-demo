name: Context Demo
on: push

jobs: 
  show-info:
    runs-on: ubuntu-latest
    steps:
      - name: Print the Github Info
        run | 
          echo "Repository: ${{ github.reposiroty }}"
          echo "Brach: ${{ github.ref_name }}"
          echo "Triggered by: ${{ github.actor }}"
          echo "Event Type: ${{ github.event_name }}"
          echo "Running on OS: ${{ runner.os }}"
